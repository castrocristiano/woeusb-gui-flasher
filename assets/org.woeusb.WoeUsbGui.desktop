[Desktop Entry]
Name=WoeUSB-GUI
Comment=Universal Windows USB bootable flasher for Linux
Comment[pt_BR]=Gravador universal de pendrives inicializáveis do Windows para Linux
Exec=woeusb-gui
Icon=org.woeusb.WoeUsbGui
Terminal=false
Type=Application
Categories=Utility;Archiving;Qt;
Keywords=windows;usb;boot;flasher;iso;woeusb;uefi;
Keywords[pt_BR]=windows;usb;boot;gravador;pendrive;iso;woeusb;uefi;
StartupNotify=true
StartupWMClass=woeusb-gui
